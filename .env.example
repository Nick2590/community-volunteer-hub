# PostgreSQL connection string (Neon serverless driver). Copy this file to .env.local and fill it in.
# Never commit real credentials.
DATABASE_URL=

# Auth.js v5 secret used to sign session tokens. Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Set to true only for local production runs (npm run build && npm start). Vercel detects the host automatically.
AUTH_TRUST_HOST=
